import { Button, ComboBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Compressor";
    preferred-width: 360px;
    preferred-height: 640px;

    in-out property <int> percent: 50;
    in-out property <int> format-index: 0;
    in-out property <string> status: "";
    callback pick-and-compress();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text { text: "Target size: " + percent + "%"; font-size: 20px; }

        HorizontalLayout {
            spacing: 12px;
            Button { text: "-5"; clicked => { if (percent > 5) { percent -= 5; } } }
            Button { text: "+5"; clicked => { if (percent < 90) { percent += 5; } } }
        }

        ComboBox {
            model: ["Original", "mp4", "webm", "jpg", "png", "webp"];
            current-index <=> format-index;
        }

        Button { text: "Choose files and compress"; clicked => { pick-and-compress(); } }
        Text { text: status; wrap: word-wrap; }
    }
}
